<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" prefWidth="680.0" styleClass="tela-parque" stylesheets="@tema-parque.css" fx:controller="com.ufrpe.parkadventure.controller.PagamentoCartaoController">
  <top>
    <Label text="Pagamento com cartão" styleClass="cabecalho-pagamento" alignment="CENTER" maxWidth="Infinity" />
  </top>
  <center>
    <VBox alignment="CENTER" spacing="16.0" maxWidth="620.0" styleClass="cartao-pagamento" BorderPane.alignment="CENTER">
      <padding><Insets top="24" right="28" bottom="24" left="28" /></padding>
      <Label text="Valor a pagar" styleClass="subtitulo-parque" />
      <Label fx:id="lblValor" text="R$ 0,00" styleClass="valor-pagamento" />
      <GridPane hgap="12" vgap="12" styleClass="grade-cartao">
        <children>
          <Label text="Número do cartão" GridPane.rowIndex="0" />
          <TextField fx:id="txtNumeroCartao" promptText="0000 0000 0000 0000" maxWidth="Infinity" GridPane.rowIndex="1" />
          <Label text="Nome impresso no cartão" GridPane.rowIndex="2" />
          <TextField fx:id="txtNomeCartao" promptText="Nome completo" maxWidth="Infinity" GridPane.rowIndex="3" />
          <Label text="Validade (MM/AA)" GridPane.rowIndex="4" />
          <TextField fx:id="txtValidade" promptText="MM/AA" GridPane.rowIndex="5" />
          <Label text="CVV" GridPane.columnIndex="1" GridPane.rowIndex="4" />
          <PasswordField fx:id="pfCvv" promptText="123" GridPane.columnIndex="1" GridPane.rowIndex="5" />
          <Label text="Parcelas" GridPane.rowIndex="6" />
          <ComboBox fx:id="cbParcelas" maxWidth="Infinity" GridPane.rowIndex="7" />
        </children>
        <columnConstraints>
          <javafx.scene.layout.ColumnConstraints percentWidth="50" />
          <javafx.scene.layout.ColumnConstraints percentWidth="50" />
        </columnConstraints>
      </GridPane>
      <Label fx:id="lblStatus" text="Preencha os dados do cartão." styleClass="status-pagamento" wrapText="true" />
    </VBox>
  </center>
  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="rodape-acoes">
      <padding><Insets top="12" right="20" bottom="16" left="20" /></padding>
      <children>
        <Button fx:id="btnVoltar" text="Voltar" styleClass="botao-secundario" onAction="#aoVoltar" wrapText="true" />
        <Button fx:id="btnPagar" text="Pagar" styleClass="botao-primario" onAction="#aoPagar" wrapText="true" />
      </children>
    </HBox>
  </bottom>
</BorderPane>