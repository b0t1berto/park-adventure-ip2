<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" prefHeight="400.0" prefWidth="720.0" styleClass="tela-parque" stylesheets="@tema-parque.css" fx:controller="com.ufrpe.parkadventure.controller.RedirecionamentoPagamentoController">
   <center>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="16.0" styleClass="cartao-redirecionamento" stylesheets="@tema-parque.css" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label fx:id="lblMensagem" styleClass="titulo-redirecionamento" text="Quase lá!">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
            <Label styleClass="subtitulo-parque" text="Estamos te levando para o pagamento" textAlignment="CENTER" wrapText="true" />
            <ProgressIndicator prefHeight="90.0" prefWidth="90.0" progress="-1.0" />
         </children>
      </VBox>
   </center>
   <top>
      <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque" BorderPane.alignment="CENTER">
         <image>
            <Image url="@imagens/logo.png" />
         </image>
         <BorderPane.margin>
            <Insets bottom="20.0" top="20.0" />
         </BorderPane.margin>
      </ImageView>
   </top>
</BorderPane>