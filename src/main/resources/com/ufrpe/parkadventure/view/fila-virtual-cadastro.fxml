<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" prefWidth="560.0" styleClass="tela-parque" fx:controller="com.ufrpe.parkadventure.controller.CadastroFilaVirtualController">
   <stylesheets>
      <URL value="@tema-parque.css" />
      <URL value="@fila-virtual.css" />
   </stylesheets>
   <top>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="4.0" styleClass="cabecalho-pagamento" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label styleClass="titulo-fila" text="Fila virtual" />
            <Label styleClass="subtitulo-fila" text="Escolha a atração e o horário para garantir sua vez" />
            <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque">
               <image>
                  <Image url="@imagens/logo.png" />
               </image>
            </ImageView>
         </children>
      </VBox>
   </top>
   <center>
      <VBox maxWidth="720.0" prefHeight="200.0" prefWidth="100.0" spacing="14.0" styleClass="cartao-pagamento" BorderPane.alignment="TOP_CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label fx:id="lblVisitante" styleClass="nome-visitante" text="Visitante" />
                  <Label fx:id="lblDataVisita" styleClass="selo-data" text="Visita em --/--/----" />
               </children>
            </HBox>
            <Label styleClass="rotulo-campo" text="Atração" />
            <ComboBox fx:id="cbAtracao" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Selecione uma atração" />
            <Label styleClass="rotulo-campo" text="Horário" />
            <ComboBox fx:id="cbHorario" maxWidth="1.7976931348623157E308" prefWidth="150.0" promptText="Selecione um horário (11:00 às 18:00)" />
            <Label fx:id="lblDetalhe" styleClass="detalhe-fila" wrapText="true" />
            <Label fx:id="lblResultado" maxWidth="1.7976931348623157E308" styleClass="status-pagamento" wrapText="true" />
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label styleClass="rotulo-campo" text="Sua posição:" />
                  <Label fx:id="lblPosicao" styleClass="posicao-fila" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="12.0" styleClass="rodape-acoes" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" styleClass="botao-secundario" text="Voltar" wrapText="true" />
            <Button fx:id="btnEntrar" mnemonicParsing="false" onAction="#aoEntrarNaFila" styleClass="botao-primario" text="Entrar na fila" wrapText="true" />
         </children>
      </HBox>
   </bottom>
</BorderPane>