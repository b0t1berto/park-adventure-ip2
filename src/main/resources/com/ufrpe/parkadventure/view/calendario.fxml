<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.CalendarioController" styleClass="tela-parque">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="titulo-tela" text="Calendário" />
            <Label styleClass="subtitulo" text="Feriados nacionais e dias com operadores escalados. Clique em um dia para ver os detalhes." />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button onAction="#onMesAnterior" text="&lt; Anterior" wrapText="true" />
                  <Label fx:id="lblMes" alignment="CENTER" minWidth="220.0" styleClass="mes" />
                  <Button onAction="#onMesSeguinte" text="Seguinte &gt;" wrapText="true" />
                  <Button onAction="#onHoje" text="Hoje" wrapText="true" />
                  <Label fx:id="lblStatusApi" styleClass="erro" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="8.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <GridPane fx:id="grade" hgap="4.0" vgap="4.0" />
   </center>
   <bottom>
      <VBox spacing="8.0">
         <children>
            <HBox spacing="14.0">
               <children>
                  <Label styleClass="legenda-hoje" text="Hoje" />
                  <Label styleClass="legenda-feriado" text="Feriado nacional" />
                  <Label styleClass="legenda-escala" text="Operadores escalados" />
               </children>
            </HBox>
            <Label fx:id="lblDetalhe" maxWidth="Infinity" minHeight="78.0" styleClass="detalhe" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>