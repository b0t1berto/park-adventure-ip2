<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="tela-parque" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.CalendarioController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="6.0" styleClass="cabecalho-pagamento">
         <children>
            <Label styleClass="titulo-cabecalho" text="Calendário" />
            <Label styleClass="subtitulo-cabecalho" text="Feriados nacionais e dias com operadores escalados. Clique em um dia para ver os detalhes." />
            <HBox alignment="TOP_CENTER" spacing="10.0">
               <children>
                  <Button onAction="#onMesAnterior" styleClass="botao-secundario" text="Anterior" />
                  <Label fx:id="lblMes" alignment="CENTER" minWidth="220.0" styleClass="mes-cabecalho" />
                  <Button onAction="#onMesSeguinte" styleClass="botao-secundario" text="Seguinte" />
                  <Button onAction="#onHoje" styleClass="botao-secundario" text="Hoje" />
                  <Label fx:id="lblStatusApi" styleClass="status-cabecalho" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <GridPane fx:id="grade" hgap="4.0" vgap="4.0">
         <BorderPane.margin>
            <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin></GridPane>
   </center>
   <bottom>
      <VBox spacing="8.0" styleClass="rodape-acoes">
         <children>
            <HBox spacing="14.0">
               <children>
                  <Label styleClass="legenda-hoje" text="Hoje" />
                  <Label styleClass="legenda-feriado" text="Feriado nacional" />
                  <Label styleClass="legenda-escala" text="Operadores escalados" />
               </children>
            </HBox>
            <Label fx:id="lblDetalhe" maxWidth="Infinity" minHeight="78.0" styleClass="detalhe" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
   </stylesheets>
</BorderPane>
