<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="aba-relatorio" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatorioDiaController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Dia:" />
            <Button onAction="#onDiaAnterior" styleClass="botao-secundario" text="&lt;" />
            <DatePicker fx:id="dpDia" />
            <Button onAction="#onProximoDia" styleClass="botao-secundario" text="&gt;" />
            <Button onAction="#onHoje" styleClass="botao-secundario" text="Hoje" />
            <Button onAction="#onExportarCsv" styleClass="botao-principal" text="Exportar CSV" />
            <Label fx:id="lblDiaSemana" styleClass="titulo-secao" />
            <Label fx:id="lblFeriado" styleClass="subtitulo" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="12.0">
         <children>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Ingressos vendidos no dia" />
                  <Label fx:id="lblVendidos" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita do dia" />
                  <Label fx:id="lblReceita" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Visitas previstas" />
                  <Label fx:id="lblVisitas" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Capacidade máxima" />
                  <Label fx:id="lblCapacidade" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Vagas restantes" />
                  <Label fx:id="lblVagas" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Fura-fila reservado" />
                  <Label fx:id="lblReservas" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Operadores escalados" />
                  <Label fx:id="lblOperadores" styleClass="card-valor" text="-" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-secao" text="Capacidade do Parque" />
            <Label fx:id="lblOcupacao" text="-" />
            <ProgressBar fx:id="pbOcupacao" maxWidth="1.7976931348623157E308" prefHeight="16.0" progress="0.0" />
            <Label fx:id="lblSituacao" maxWidth="1.7976931348623157E308" wrapText="true" />
         </children>
      </VBox>
      <Label styleClass="titulo-secao" text="Ingressos comprados ou com visita neste dia" />
      <TableView fx:id="tabela" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colVisitante" text="Visitante" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colRelacao" text="Neste dia" />
            <TableColumn fx:id="colCompra" text="Compra" />
            <TableColumn fx:id="colVisita" text="Validade / visita" />
            <TableColumn fx:id="colValor" text="Valor" />
            <TableColumn fx:id="colPagamento" text="Pagamento" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</VBox>
