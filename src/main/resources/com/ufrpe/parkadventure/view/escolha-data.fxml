<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="520.0" styleClass="tela-parque" stylesheets="@tema-parque.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.EscolhaDataController">
   <top>
      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cabecalho-pagamento" text="Escolha a data da visita" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </Label>
   </top>
   <center>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="440.0" spacing="16.0" styleClass="cartao-pagamento" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque">
               <image>
                  <Image url="@imagens/logo.png" />
               </image>
            </ImageView>
            <Label maxWidth="1.7976931348623157E308" prefWidth="380.0" styleClass="subtitulo-parque" text="Selecione o dia em que você quer visitar o parque" textAlignment="CENTER" wrapText="true" />
            <DatePicker fx:id="dpDataVisita" prefWidth="280.0" promptText="mm/dd/aaaa" styleClass="campo-data" />
            <Label fx:id="lblData" styleClass="etiqueta-pedido" text="Nenhuma data selecionada" />
            <Label fx:id="lblErro" maxWidth="1.7976931348623157E308" styleClass="erro-parque" textAlignment="CENTER" />
         </children>
         <BorderPane.margin>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="rodape-acoes" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" styleClass="botao-secundario" text="Voltar" />
            <Button fx:id="btnContinuar" mnemonicParsing="false" onAction="#aoContinuar" styleClass="botao-primario" text="Continuar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
