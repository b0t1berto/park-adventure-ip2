<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.collections.*?>
<?import javafx.util.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.FilaVirtualController" styleClass="tela-parque">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="titulo-tela" text="Posição na fila virtual" />
            <Label fx:id="lblVisitante" styleClass="subtitulo" />
            <Label fx:id="lblDestaque" maxWidth="Infinity" styleClass="destaque" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela">
         <columns>
            <TableColumn fx:id="colAtracao" text="Atração" />
            <TableColumn fx:id="colHorario" text="Horário escolhido" />
            <TableColumn fx:id="colPosicaoHorario" text="Posição no horário" />
            <TableColumn fx:id="colPosicaoGeral" text="Ordem de chamada" />
            <TableColumn fx:id="colTotal" text="Total na fila" />
            <TableColumn fx:id="colOcupacao" text="Ocupação da atração" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button onAction="#onAtualizar" styleClass="botao-principal" text="Atualizar agora" wrapText="true" />
                  <Button onAction="#onVoltarParaIngressos" text="Voltar para ingressos comprados" wrapText="true" />
                  <Label fx:id="lblAtualizado" styleClass="subtitulo" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets top="12.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>