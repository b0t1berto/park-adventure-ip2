<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="tela-parque" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.view.UsarPasseController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="6.0" styleClass="cabecalho-pagamento" BorderPane.alignment="TOP_CENTER">
         <children>
            <Label styleClass="titulo-cabecalho" text="Usar passe" />
            <Label fx:id="lblVisitante" styleClass="subtitulo-cabecalho" />
            <Label styleClass="subtitulo-cabecalho" text="O passe anual dá direito a 1 ingresso por mês. Escolha o dia de cada mês em que você vai ao parque." wrapText="true" />
         </children>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela" styleClass="tabela-parque">
         <columns>
            <TableColumn fx:id="colMes" text="Mês" />
            <TableColumn fx:id="colDia" text="Dia escolhido" />
            <TableColumn fx:id="colSituacao" text="Situação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="8.0" styleClass="rodape-acoes">
         <children>
            <Label fx:id="lblResumo" styleClass="subtitulo" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Dia da visita:" />
                  <DatePicker fx:id="dpData" styleClass="date-picker-popup" />
                  <Button fx:id="btUsar" onAction="#onUsar" styleClass="botao-primario" text="Usar passe neste dia" />
                  <Button fx:id="btCancelar" onAction="#onCancelar" styleClass="botao-secundario" text="Trocar o dia do mês selecionado" />
                  <Button onAction="#onVoltar" styleClass="botao-secundario" text="Voltar" />
               </children>
            </HBox>
            <Label fx:id="lblStatus" maxWidth="Infinity" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
   </stylesheets>
</BorderPane>
