<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="980.0" styleClass="tela-parque" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatoriosController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="4.0" styleClass="cabecalho-pagamento">
         <children>
            <Label styleClass="titulo-cabecalho" text="Relatórios" />
            <Label styleClass="subtitulo-cabecalho" text="Visão geral do parque, ingressos, lucro e atrações" />
         </children>
         <padding>
            <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab fx:id="tabGeral" text="Geral">
               <content>
                  <fx:include fx:id="geral" source="relatorio-geral.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabDia" text="Dia">
               <content>
                  <fx:include fx:id="dia" source="relatorio-dia.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabIngresso" text="Ingresso">
               <content>
                  <fx:include fx:id="ingresso" source="relatorio-ingresso.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabLucro" text="Lucro">
               <content>
                  <fx:include fx:id="lucro" source="relatorio-lucro.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabAtracao" text="Atração">
               <content>
                  <fx:include fx:id="atracao" source="relatorio-atracao.fxml" />
               </content>
            </Tab>
            <Tab fx:id="tabListaIngressos" text="Ingressos">
               <content>
                  <VBox spacing="14.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="rotulo-campo" text="Buscar por usuário" />
                              <TextField fx:id="txtBuscaIngresso" prefWidth="220.0" promptText="Parte do usuário ou do nome" />
                              <Label fx:id="lblTotalIngressos" styleClass="rotulo-campo" />
                           </children>
                        </HBox>
                        <TableView fx:id="tabelaIngressos" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colIngUsuario" text="Usuário" />
                              <TableColumn fx:id="colIngTipo" text="Tipo" />
                              <TableColumn fx:id="colIngCompra" text="Compra" />
                              <TableColumn fx:id="colIngValidade" text="Validade" />
                              <TableColumn fx:id="colIngValor" text="Valor" />
                              <TableColumn fx:id="colIngPagamento" text="Pagamento" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="rotulo-campo" text="Ingressos emitidos em" />
                              <DatePicker fx:id="dpDataEmissao" />
                              <Button onAction="#onConsultarData" styleClass="botao-secundario" text="Consultar" />
                              <Label fx:id="lblQtdData" styleClass="rotulo-campo" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
         <BorderPane.margin>
            <Insets bottom="4.0" left="12.0" right="12.0" top="12.0" />
         </BorderPane.margin>
      </TabPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" styleClass="rodape-acoes">
         <children>
            <Button onAction="#onAtualizar" styleClass="botao-primario" text="Atualizar" />
            <Button onAction="#onVoltar" styleClass="botao-secundario" text="Voltar" />
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
      </HBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</BorderPane>
