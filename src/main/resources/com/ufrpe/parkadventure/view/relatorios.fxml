<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660.0" prefWidth="860.0" styleClass="tela-parque" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatoriosController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="6.0" styleClass="cabecalho-pagamento">
         <children>
            <Label styleClass="titulo-cabecalho" text="Relatórios do parque" />
            <Label styleClass="subtitulo-cabecalho" text="Visão geral das atrações e receita de ingressos por mês." />
         </children>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab text="Visão geral">
               <content>
                  <VBox spacing="14.0">
                     <children>
                        <FlowPane hgap="12.0" vgap="12.0">
                           <children>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblVisitantes" styleClass="numero-resumo" text="0" />
                                    <Label styleClass="legenda-resumo" text="Visitantes cadastrados" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblIngressos" styleClass="numero-resumo" text="0" />
                                    <Label styleClass="legenda-resumo" text="Ingressos vendidos" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblReceitaTotal" styleClass="numero-resumo" text="R$ 0,00" />
                                    <Label styleClass="legenda-resumo" text="Receita total" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblAtracoes" styleClass="numero-resumo" text="0" />
                                    <Label styleClass="legenda-resumo" text="Atrações" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblSemOperador" styleClass="numero-resumo" text="0" />
                                    <Label styleClass="legenda-resumo" text="Fechadas (sem operador)" />
                                 </children>
                              </VBox>
                           </children>
                        </FlowPane>
                        <Label styleClass="rotulo-campo" text="Ocupação das atrações" />
                        <TableView fx:id="tabelaOcupacao" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colAtracao" text="Atração" />
                              <TableColumn fx:id="colOcupacao" text="Ocupação" />
                              <TableColumn fx:id="colFila" text="Fila virtual" />
                              <TableColumn fx:id="colSituacao" text="Situação" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Button onAction="#onExportarCsv" styleClass="botao-secundario" text="Exportar atrações (CSV)" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Receita por mês">
               <content>
                  <VBox spacing="14.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="rotulo-campo" text="Mês" />
                              <ComboBox fx:id="cbMes" prefWidth="160.0" />
                              <Label styleClass="rotulo-campo" text="Ano" />
                              <TextField fx:id="txtAno" prefWidth="80.0" />
                              <Button fx:id="btnGerar" onAction="#onGerarReceita" styleClass="botao-primario" text="Gerar relatório" />
                           </children>
                        </HBox>
                        <FlowPane hgap="12.0" vgap="12.0">
                           <children>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblQtdMes" styleClass="numero-resumo" text="-" />
                                    <Label styleClass="legenda-resumo" text="Ingressos no mês" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblReceitaMes" styleClass="numero-resumo" text="-" />
                                    <Label styleClass="legenda-resumo" text="Receita do mês" />
                                 </children>
                              </VBox>
                              <VBox styleClass="card-resumo">
                                 <children>
                                    <Label fx:id="lblReceitaFeriados" styleClass="numero-resumo" text="-" />
                                    <Label styleClass="legenda-resumo" text="Receita em feriados" />
                                 </children>
                              </VBox>
                           </children>
                        </FlowPane>
                        <Label fx:id="lblStatusReceita" maxWidth="Infinity" wrapText="true" />
                        <TableView fx:id="tabelaVendas" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colData" text="Data da compra" />
                              <TableColumn fx:id="colValor" text="Valor" />
                              <TableColumn fx:id="colFeriado" text="Feriado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </content>
            </Tab>
         </tabs>
         <BorderPane.margin>
            <Insets bottom="4.0" left="20.0" right="20.0" top="12.0" />
         </BorderPane.margin>
      </TabPane>
   </center>
   <bottom>
      <VBox spacing="10.0" styleClass="rodape-acoes">
         <children>
            <Label fx:id="lblResultado" maxWidth="Infinity" wrapText="true" />
            <FlowPane alignment="CENTER" hgap="10.0" vgap="8.0">
               <children>
                  <Button onAction="#onVoltar" styleClass="botao-secundario" text="Voltar" />
               </children>
            </FlowPane>
         </children>
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
   </stylesheets>
</BorderPane>
