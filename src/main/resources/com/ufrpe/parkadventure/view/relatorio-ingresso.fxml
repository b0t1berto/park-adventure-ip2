<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="aba-relatorio" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatorioIngressoController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Mês:" />
            <ComboBox fx:id="cbMes" prefWidth="150.0" />
            <Label text="Ano:" />
            <ComboBox fx:id="cbAno" prefWidth="100.0" />
            <Button onAction="#onExportarCsv" styleClass="botao-principal" text="Exportar CSV" />
            <Label styleClass="subtitulo" text="Linhas em vermelho = vendas em feriado nacional" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="12.0">
         <children>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Ingressos vendidos" />
                  <Label fx:id="lblQuantidade" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Diárias" />
                  <Label fx:id="lblDiarias" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Passes anuais" />
                  <Label fx:id="lblPasses" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita total" />
                  <Label fx:id="lblReceita" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita em feriados" />
                  <Label fx:id="lblReceitaFeriados" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Ticket médio" />
                  <Label fx:id="lblTicketMedio" styleClass="card-valor" text="-" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <TableView fx:id="tabela" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colData" text="Data da compra" />
            <TableColumn fx:id="colVisitante" text="Visitante" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colValor" text="Valor" />
            <TableColumn fx:id="colPagamento" text="Pagamento" />
            <TableColumn fx:id="colFeriado" text="Feriado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</VBox>
