<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Tela de pagamento com Pix. Os ids e os métodos abaixo são os usados por PagamentoPixController:
  lblValor, lblTempo, lblStatus, ivQrCode, txtCodigoPix, btnCopiar, btnVoltar, btnJaPaguei
  e os métodos aoCopiar(), aoConfirmar() e aoVoltar().
  (O arquivo anterior era uma cópia do formulário de pagamento, com o controller errado.)
-->
<BorderPane prefWidth="600.0" styleClass="tela-parque" stylesheets="@tema-parque.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.PagamentoPixController">
    <top>
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cabecalho-pagamento" text="Pagamento com Pix" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </Label>
    </top>
    <center>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="720.0" prefWidth="540.0" spacing="12.0" styleClass="cartao-pagamento" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="subtitulo-parque" text="Valor a pagar" />
                <Label fx:id="lblValor" styleClass="valor-total" text="R$ 0.00" />
                <ImageView fx:id="ivQrCode" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="lblTempo" styleClass="subtitulo-parque" text="Expira em 05:00" />
                <Label styleClass="subtitulo-parque" text="Pix copia e cola" />
                <TextField fx:id="txtCodigoPix" editable="false" maxWidth="1.7976931348623157E308" styleClass="codigo-pagamento" />
                <Button fx:id="btnCopiar" mnemonicParsing="false" onAction="#aoCopiar" styleClass="botao-secundario" text="Copiar código" />
                <Label maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefWidth="480.0" styleClass="subtitulo-parque" text="Abra o app do seu banco, escolha pagar com Pix e leia o QR Code ou cole o código acima." textAlignment="CENTER" wrapText="true" />
                <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" styleClass="status-pagamento" text="Aguardando pagamento" textAlignment="CENTER" />
            </children>
            <BorderPane.margin>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </BorderPane.margin>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="rodape-acoes" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" styleClass="botao-secundario" text="Voltar" />
                <Button fx:id="btnJaPaguei" mnemonicParsing="false" onAction="#aoConfirmar" styleClass="botao-primario" text="Já paguei" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
