<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="tela-parque" fx:controller="com.ufrpe.parkadventure.controller.TelaIngressoController">
  <top><VBox spacing="6" styleClass="barra-topo"><padding><Insets top="14" right="20" bottom="14" left="20" /></padding><children><Label text="Emissão de ingressos" styleClass="titulo-app" /><Label fx:id="lblVisitante" styleClass="subtitulo-fila" wrapText="true" /></children></VBox></top>
  <center><VBox alignment="CENTER" spacing="14" maxWidth="640" styleClass="cartao-pagamento" BorderPane.alignment="CENTER"><padding><Insets top="24" right="28" bottom="24" left="28" /></padding><children>
    <Label text="Escolha o ingresso e a data da visita" styleClass="titulo-tela" wrapText="true" />
    <Label text="Tipo de ingresso" /><ComboBox fx:id="cbTipo" maxWidth="Infinity" promptText="Selecione o tipo" />
    <Label text="Data da visita" /><DatePicker fx:id="dpData" maxWidth="Infinity" />
    <Label fx:id="lblAvisoFeriado" styleClass="aviso" wrapText="true" />
    <Label text="Valor" /><Label fx:id="lblValor" styleClass="valor" />
    <Label fx:id="lblValidade" wrapText="true" /><Label fx:id="lblEmitidos" wrapText="true" />
    <Label fx:id="lblStatus" wrapText="true" />
    <Button fx:id="btnEmitir" text="Emitir ingresso" styleClass="botao-primario" onAction="#onEmitir" wrapText="true" />
    <Button text="Ver ingressos comprados" styleClass="botao-secundario" onAction="#onVerIngressosComprados" wrapText="true" />
  </children></VBox></center>
</BorderPane>