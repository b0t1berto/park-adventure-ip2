<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="tela-parque" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.IngressosCompradosController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="6.0" styleClass="cabecalho-pagamento">
         <children>
            <Label styleClass="titulo-cabecalho" text="Ingressos comprados" />
            <Label fx:id="lblVisitante" styleClass="subtitulo-cabecalho" />
            <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque">
               <image>
                  <Image url="@imagens/logo.png" />
               </image>
            </ImageView>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela" styleClass="tabela-parque">
         <columns>
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colData" text="Data da compra" />
            <TableColumn fx:id="colValidade" text="Validade" />
            <TableColumn fx:id="colValor" text="Valor" />
            <TableColumn fx:id="colSituacao" text="Situação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="10.0" styleClass="rodape-acoes">
         <children>
            <Label fx:id="lblResumo" styleClass="subtitulo" />
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button onAction="#onVerFilaVirtual" styleClass="botao-primario" text="Ver posição na fila virtual" />
                  <Button onAction="#onComprarIngresso" styleClass="botao-secundario" text="Comprar outro ingresso" />
                  <Button onAction="#onVoltar" styleClass="botao-secundario" text="Voltar">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
   </stylesheets>
</BorderPane>
