<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.IngressosCompradosController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="titulo-tela" text="Ingressos comprados" />
            <Label fx:id="lblVisitante" styleClass="subtitulo" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela">
         <columns>
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colData" text="Data da compra" />
            <TableColumn fx:id="colValidade" text="Validade" />
            <TableColumn fx:id="colValor" text="Valor" />
            <TableColumn fx:id="colSituacao" text="Situação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="10.0">
         <children>
            <Label fx:id="lblResumo" styleClass="subtitulo" />
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btVerFilaVirtual" onAction="#onVerFilaVirtual" styleClass="botao-principal" text="Ver posição na fila virtual" />
                  <Button fx:id="btComprarIngresso" onAction="#onComprarIngresso" text="Comprar outro ingresso" />
                  <Button fx:id="btVoltar" onAction="#onVoltar" text="&lt;">
                     <HBox.margin>
                        <Insets left="25.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets top="12.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>
