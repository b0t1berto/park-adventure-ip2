<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.collections.*?>
<?import javafx.util.*?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" prefHeight="400.0" prefWidth="600.0" styleClass="tela-parque" stylesheets="@tema-parque.css" fx:controller="com.ufrpe.parkadventure.controller.LoginVisitanteController">
   <top>
      <StackPane prefHeight="68.0" prefWidth="600.0" style="-fx-background-color: #5ba6b9;" BorderPane.alignment="CENTER">
         <effect>
            <DropShadow offsetY="3.0" />
         </effect>
         <children>
            <Pane prefHeight="200.0" prefWidth="200.0" styleClass="cabecalho-pagamento" stylesheets="@tema-parque.css">
               <children>
                  
                  <Label fx:id="lblBoasVindas" alignment="CENTER" layoutX="40.0" layoutY="19.0" prefHeight="36.0" prefWidth="442.0" text="Bem-Vindo ao Menu de Visitantes!" textFill="WHITE">
                     <font>
                        <Font name="DejaVu Sans Mono Bold" size="24.0" />
                     </font>
                  </Label>
                  
                  
                  <MenuButton layoutX="495.0" layoutY="8.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="84.0" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <items>
                      <MenuItem mnemonicParsing="false" text="Meu Perfil" />
                      <MenuItem mnemonicParsing="false" text="Configurações" />
                      <MenuItem fx:id="menuVoltar" mnemonicParsing="false" onAction="#onVoltar" text="Sair" />
                    </items>
                     <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              
                              <Image url="@imagens/guest.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </MenuButton>
               </children>
            </Pane>
         </children>
      </StackPane>
   </top>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="25.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="bntComparIngresso" mnemonicParsing="false" onAction="#onComprarIngresso" prefHeight="45.0" prefWidth="250.0" styleClass="botao-primario" stylesheets="@tema-parque.css" text="Comprar Ingressos" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="13.0" />
               </font>
               <effect>
                  <DropShadow color="#aaaaaa" offsetY="2.0" />
               </effect>
            </Button>
            <Button fx:id="bntVerIngresso" mnemonicParsing="false" onAction="#onVerIngresso" prefHeight="45.0" prefWidth="250.0" styleClass="botao-primario" stylesheets="@tema-parque.css" text="Meu Histórico" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="14.0" />
               </font>
               <effect>
                  <DropShadow color="#aaaaaa" offsetY="2.0" />
               </effect>
            </Button>
            <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" styleClass="botao-primario" stylesheets="@tema-parque.css" text="Ver Atrações" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Bold" size="14.0" />
               </font>
               <effect>
                  <DropShadow color="#aaaaaa" offsetY="2.0" />
               </effect>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>