                                                <Color red="1.0" green="1.0" blue="1.0" />
                                             </color>
                                          </Shadow>
                                       </bumpInput>
                                       <light>
                                          <Light.Distant />
                                       </light>
                                    </Lighting>
                                 </input>
                              </DropShadow>
                           </input>
                        </DropShadow>
                     </effect>
                           <font>
                              <Font size="86.0" />
                           </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </StackPane>
   </top>
   <right>
      <StackPane prefHeight="305.0" prefWidth="118.0" style="-fx-background-color: #5ba6b9;" BorderPane.alignment="CENTER">
