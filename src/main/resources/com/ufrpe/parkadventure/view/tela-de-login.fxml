<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.paint.Color?>

<StackPane alignment="CENTER" prefHeight="700.0" prefWidth="1000.0" styleClass="tela-parque" stylesheets="@tema-parque.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.TelaLoginController">
   <children>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <StackPane prefHeight="68.0" prefWidth="600.0" style="-fx-background-color: #5ba6b9;" BorderPane.alignment="CENTER">
         <effect>
            <DropShadow offsetY="3.0" />
         </effect>
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ImageView fx:id="imgLogo" fitHeight="154.0" fitWidth="177.0" pickOnBounds="true">
                     <image>
                        <Image url="@imagens/logo.png" />
                     </image>
                     <effect>
                        <DropShadow />
                     </effect>
                           <HBox.margin>
                              <Insets left="25.0" right="25.0" />
                           </HBox.margin>
                  </ImageView>
<Label fx:id="lblParkAdventure" prefHeight="154.0" prefWidth="755.0" styleClass="titulo-menu" text=" Park Adventure" textFill="WHITE">
                      <effect>
                         <DropShadow height="13.75" offsetX="3.0" offsetY="2.0" radius="6.6875" spread="0.39" width="15.0">
                            <color>
                               <Color red="0.039" green="0.235" blue="0.552" />
                            </color>
                            <input>
                               <DropShadow height="18.75" offsetX="1.0" offsetY="1.0" radius="9.1875" spread="0.14" width="20.0">
                                  <color>
                                     <Color red="0.629" green="0.697" blue="0.943" />
                                  </color>
                                  <input>
                                     <Lighting specularConstant="0.5">
                                        <bumpInput>
                                           <Shadow blurType="GAUSSIAN">
                                              <color>
                                                 <Color red="1.0" green="1.0" blue="1.0" />
                                              </color>
                                           </Shadow>
                                        </bumpInput>
                                        <light>
                                           <Light.Distant />
                                        </light>
                                     </Lighting>
                                  </input>
                               </DropShadow>
                            </input>
                         </DropShadow>
                      </effect>
                            <HBox.margin>
                               <Insets left="25.0" right="25.0" />
                            </HBox.margin>
                   </Label>
               </children>
            </HBox>
         </children>
      </StackPane>
   </top>
   <right>
      <StackPane prefHeight="305.0" prefWidth="118.0" style="-fx-background-color: #5ba6b9;" BorderPane.alignment="CENTER">
         <effect>
            <DropShadow offsetY="7.0" />
         </effect>
      </StackPane>
   </right>
   <left>
      <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Botão Voltar idêntico ao da tela de criar conta -->
            <Button fx:id="btVoltar" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#onVoltar" styleClass="botao-primario" stylesheets="@tema-parque.css" text="&lt;" textFill="WHITE">
<effect>
                         <DropShadow />
                      </effect>
            </Button>
         </children>
      </Pane>
   </left>
   <center>
      <Pane layoutX="-74.0" layoutY="55.0" prefHeight="305.0" prefWidth="118.0" BorderPane.alignment="CENTER">
         <children>
            
            <TextField fx:id="txtUsuario" layoutX="163.0" layoutY="202.0" prefHeight="35.0" prefWidth="200.0">
                     <effect>
                        <DropShadow />
                     </effect></TextField>
            
            <!-- Botão OK com o mesmo estilo do botão Confirmar da tela de criar conta -->
<Button fx:id="btOk" layoutX="177.0" layoutY="450.0" mnemonicParsing="false" onAction="#onConfirmar" prefHeight="50.0" prefWidth="170.0" styleClass="botao-primario" stylesheets="@tema-parque.css" text="Confirmar" textFill="WHITE">
                      <effect>
                         <DropShadow />
                      </effect>
             </Button>
            <ImageView fitHeight="329.0" fitWidth="312.0" layoutX="480.0" layoutY="218.0" pickOnBounds="true">
               <image>
                  <Image url="@imagens/homem-Photoroom.png" />
               </image>
               <effect>
                  <DropShadow />
               </effect>
            </ImageView>
            <!-- Substituí o Circle azul genérico por um texto de boas vindas estilizado -->
<Label fx:id="lblDivertir" layoutX="459.0" layoutY="155.0" prefHeight="95.0" prefWidth="320.0" styleClass="cartao-pagamento" text="Acesse sua conta para continuar!" textAlignment="CENTER" wrapText="true">
                <effect>
                   <DropShadow height="20.0" radius="9.5" width="20.0">
                      <color>
                         <Color red="0.6065213680267334" green="0.6065213680267334" blue="0.6065213680267334" />
                      </color>
                      <input>
                         <DropShadow />
                      </input>
                   </DropShadow>
                </effect>
             </Label>
            
<Label fx:id="lblBemVindoDeVolta" layoutX="76.0" layoutY="26.0" prefHeight="107.0" prefWidth="373.0" styleClass="cartao-pagamento" text="Bem-vindo de volta! Faça seu login." textAlignment="CENTER" wrapText="true">
                      <effect>
                         <DropShadow />
                      </effect>
             </Label>
            
<Label fx:id="lblUsuario" layoutX="56.0" layoutY="218.0" prefWidth="90.0" text="Usuário:" textFill="WHITE">
                      <effect>
                         <DropShadow />
                      </effect>
             </Label>
            
<Label fx:id="lblSenha" layoutX="56.0" layoutY="302.0" text="Senha:" textFill="WHITE">
                      <effect>
                         <DropShadow />
                      </effect>
             </Label>
                  <PasswordField fx:id="txtSenha" layoutX="168.0" layoutY="296.0" prefHeight="35.0" prefWidth="200.0">
                     <effect>
                        <DropShadow />
                     </effect>
                  </PasswordField>
         </children>
      </Pane>
   </center>
</BorderPane>
   </children>
</StackPane>
