            </Label>
            
            <Label fx:id="lblCargo" layoutY="367.0" prefHeight="59.0" prefWidth="135.0" text="Cargo (Opcional):" textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="20.0" />
               </font>
                     <effect>
                        <DropShadow />
                     </effect>
            </Label>
         </children>
      </Pane>
   </center>
</BorderPane>
   </children>
</StackPane>
