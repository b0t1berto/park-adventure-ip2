                     <effect>
                        <DropShadow />
                     </effect>
                           <HBox.margin>
                              <Insets left="25.0" right="25.0" />
                           </HBox.margin>
                  </ImageView>
                  <Label fx:id="lblParkAdventure" prefHeight="170.0" prefWidth="679.0" text=" Park Adventure" textFill="WHITE">
