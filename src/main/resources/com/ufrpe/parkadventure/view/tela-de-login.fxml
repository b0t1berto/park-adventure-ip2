                     </input>
                  </DropShadow>
               </effect>
                     <font>
                        <Font name="DejaVu Sans Mono Bold" size="20.0" />
                     </font>
            </Label>
            
            <Label layoutX="65.0" layoutY="69.0" prefHeight="96.0" prefWidth="396.0" text="Bem-vindo de volta! Faça seu login." textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="30.0" />
               </font>
                     <effect>
                        <DropShadow />
                     </effect>
            </Label>
            
            <Label fx:id="lblNome" layoutX="39.0" layoutY="205.0" text="Nome:" textFill="WHITE">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="20.0" />
