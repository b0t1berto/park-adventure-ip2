<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="aba-relatorio" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatorioGeralController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button onAction="#onExportarCsv" styleClass="botao-principal" text="Exportar CSV" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="12.0">
         <children>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Visitantes cadastrados" />
                  <Label fx:id="lblVisitantes" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Ingressos emitidos" />
                  <Label fx:id="lblIngressos" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita total" />
                  <Label fx:id="lblReceita" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Ingressos hoje" />
                  <Label fx:id="lblIngressosHoje" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita hoje" />
                  <Label fx:id="lblReceitaHoje" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Atrações" />
                  <Label fx:id="lblAtracoes" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Atrações sem operador" />
                  <Label fx:id="lblSemOperador" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Atrações lotadas" />
                  <Label fx:id="lblLotadas" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Fura-fila reservado hoje" />
                  <Label fx:id="lblReservasHoje" styleClass="card-valor" text="-" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-secao" text="Ocupação atual do parque" />
            <Label fx:id="lblOcupacao" text="-" />
            <ProgressBar fx:id="pbOcupacao" maxWidth="1.7976931348623157E308" prefHeight="16.0" progress="0.0" />
         </children>
      </VBox>
      <Label styleClass="titulo-secao" text="Operadores escalados nos próximos feriados" />
      <TableView fx:id="tabelaFeriados" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colFeriado" text="Feriado" />
            <TableColumn fx:id="colData" text="Data" />
            <TableColumn fx:id="colDia" text="Dia da semana" />
            <TableColumn fx:id="colOperadores" text="Operadores escalados" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</VBox>
