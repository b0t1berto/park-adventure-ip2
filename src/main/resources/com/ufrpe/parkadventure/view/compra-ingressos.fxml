<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="-Infinity" prefWidth="720.0" styleClass="tela-parque" stylesheets="@tema-parque.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.CompraIngressosController">
   <top>
      <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btVoltar" mnemonicParsing="false" onAction="#onVoltar" prefWidth="150.0" styleClass="botao-secundario" text="Voltar">
               <VBox.margin>
                  <Insets right="550.0" />
               </VBox.margin>
            </Button>
            <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque">
               <image>
                  <Image url="@imagens/logo.png" />
               </image>
            </ImageView>
            <Label styleClass="titulo-parque" text="Bora se divertir?">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </Label>
            <Label styleClass="subtitulo-parque" text="Escolha como você quer entrar no parque" />
         </children>
         <padding>
            <Insets bottom="8.0" top="24.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <HBox alignment="CENTER" maxWidth="720.0" prefHeight="100.0" prefWidth="200.0" spacing="32.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onIngressoInstantaneo" prefHeight="170.0" prefWidth="300.0" text="Ingresso instantâneo" textAlignment="CENTER" wrapText="true">
               <styleClass>
                  <String fx:value="card-ingresso" />
                  <String fx:value="card-instantaneo" />
               </styleClass></Button>
            <Button mnemonicParsing="false" onAction="#onIngressoProgramado" prefHeight="170.0" prefWidth="300.0" text="Ingresso programado" textAlignment="CENTER" wrapText="true">
               <styleClass>
                  <String fx:value="card-ingresso" />
                  <String fx:value="card-programado" />
               </styleClass></Button>
         </children>
      </HBox>
   </center>
   <bottom>
      <Label alignment="CENTER" styleClass="rodape-parque" text="Menores de 18 anos entram acompanhados de um responsável" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>
