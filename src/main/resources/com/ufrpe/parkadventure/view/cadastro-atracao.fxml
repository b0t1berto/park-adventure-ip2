<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="820.0" styleClass="tela-parque" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.CadastroAtracaoController">
   <top>
      <VBox alignment="TOP_CENTER" spacing="6.0" styleClass="cabecalho-pagamento">
         <children>
            <Label styleClass="titulo-cabecalho" text="Cadastro de atrações" />
            <Label styleClass="subtitulo-cabecalho" text="Cadastre uma atração nova; depois, cadastre o operador dela para abri-la." />
         </children>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="14.0">
         <children>
            <GridPane hgap="14.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="140.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints minWidth="140.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="rotulo-campo" text="Nome da atração" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNome" maxWidth="Infinity" promptText="Ex.: Montanha Russa" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="rotulo-campo" text="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbTipo" maxWidth="Infinity" promptText="Escolha o tipo" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                  <Label styleClass="rotulo-campo" text="Capacidade máxima" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtCapacidade" maxWidth="Infinity" promptText="Pessoas ao mesmo tempo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label fx:id="lblAltura" styleClass="rotulo-campo" text="Altura mínima (cm)" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtAltura" maxWidth="Infinity" promptText="0 = sem limite" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                  <Label fx:id="lblIdade" styleClass="rotulo-campo" text="Idade mínima" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtIdade" maxWidth="Infinity" promptText="0 = sem limite" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <Label styleClass="rotulo-campo" text="Atrações já cadastradas" />
            <TableView fx:id="tabela" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNome" text="Atração" />
                  <TableColumn fx:id="colTipo" text="Tipo" />
                  <TableColumn fx:id="colCapacidade" text="Capacidade" />
                  <TableColumn fx:id="colRequisitos" text="Requisitos" />
                  <TableColumn fx:id="colOperador" text="Operador" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <BorderPane.margin>
            <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <bottom>
      <VBox spacing="10.0" styleClass="rodape-acoes">
         <children>
            <Label fx:id="lblResultado" maxWidth="Infinity" wrapText="true" />
            <FlowPane alignment="CENTER" hgap="10.0" vgap="8.0">
               <children>
                  <Button onAction="#onCadastrar" styleClass="botao-primario" text="Cadastrar atração" />
                  <Button onAction="#onVoltar" styleClass="botao-secundario" text="Voltar" />
               </children>
            </FlowPane>
         </children>
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
   </bottom>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
   </stylesheets>
</BorderPane>
