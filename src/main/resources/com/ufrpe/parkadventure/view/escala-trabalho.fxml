<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.collections.*?>
<?import javafx.util.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.EscalaTrabalhoController" styleClass="tela-parque">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="titulo-tela" text="Escala de trabalho" />
            <Label styleClass="subtitulo" text="Defina quais operadores trabalham em cada dia. Os feriados nacionais vêm da BrasilAPI." />
            <Label fx:id="lblProximoFeriado" maxWidth="Infinity" styleClass="aviso" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela">
         <columns>
            <TableColumn fx:id="colData" text="Data" />
            <TableColumn fx:id="colDia" text="Dia da semana" />
            <TableColumn fx:id="colOperador" text="Operador" />
            <TableColumn fx:id="colAtracao" text="Atração" />
            <TableColumn fx:id="colObservacao" text="Observação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Data:" />
                  <DatePicker fx:id="dpData" />
                  <Label text="Operador:" />
                  <ComboBox fx:id="cbOperador" prefWidth="200.0" />
                  <Button onAction="#onEscalar" styleClass="botao-principal" text="Escalar" wrapText="true" />
                  <Button onAction="#onRemover" text="Remover linha selecionada" wrapText="true" />
               </children>
            </HBox>
            <Label fx:id="lblStatus" maxWidth="Infinity" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets top="12.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>