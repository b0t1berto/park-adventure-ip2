<?xml version='1.0' encoding='UTF-8'?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #ffffff;" styleClass="tela-parque" stylesheets="@tema-parque.css" fx:controller="com.ufrpe.parkadventure.controller.TelaMenuController">
   <center>
      
      <VBox alignment="CENTER" spacing="8.0" styleClass="tela-parque" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblReservar" maxWidth="300.0" style="-fx-border-radius: 6; -fx-padding: 8; -fx-background-color: #ffffff;" styleClass="cartao-pagamento" text="Que tal reservar o acesso a uma Experiência Inédita?" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="13.0" />
               </font>
            </Label>
            <Button fx:id="bntComeceAqui" mnemonicParsing="false" onAction="#onCriarConta" prefHeight="39.0" prefWidth="187.0" style="-fx-background-color: #5ba6b9;" styleClass="botao-primario" text="Comece por Aqui" textFill="WHITE" wrapText="true">
               <effect>
                  <DropShadow offsetY="5.0">
                     <color>
                        <Color red="0.5529412031173706" green="0.5529412031173706" blue="0.5529412031173706" />
                     </color>
                  </DropShadow>
               </effect>
            </Button>
            <Label fx:id="lblDesejaReservar" prefHeight="45.0" prefWidth="223.0" styleClass="cartao-pagamento" text="Deseja acessar sua reserva?">
               <font>
                  <Font name="DejaVu Sans Mono Bold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="bntAcesseAqui" maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#onFazerLogin" prefHeight="42.0" prefWidth="156.0" style="-fx-background-color: #5ba6b9;" styleClass="botao-primario" text="Acesse Aqui!" textFill="WHITE" wrapText="true">
               <effect>
                  <DropShadow offsetY="3.0">
                     <color>
                        <Color red="0.5529412031173706" green="0.5529412031173706" blue="0.5529412031173706" />
                     </color>
                  </DropShadow>
               </effect>
            </Button>
         </children>
      </VBox>
   </center>
   <top>
      <StackPane prefHeight="101.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="134.0" fitWidth="599.0" pickOnBounds="true">
               <image>
                  <Image url="@imagens/menu-fundo.jpeg" />
               </image>
               <effect>
                  <Lighting diffuseConstant="1.17" specularConstant="0.97" specularExponent="20.38">
                     <bumpInput>
                        <Shadow>
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Shadow>
                     </bumpInput>
                     <light>
                        <Light.Distant />
                     </light>
                  </Lighting>
               </effect>
            </ImageView>
            <HBox alignment="CENTER" prefHeight="125.0" prefWidth="600.0" spacing="15.0" style="-fx-background-color: transparent; -fx-padding: 8;">
               <children>
                  <ImageView fx:id="imgLogo" fitHeight="117.0" fitWidth="118.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/logo.png" />
                     </image>
                     <effect>
                        <DropShadow />
                     </effect>
                  </ImageView>
                  <Label fx:id="lblParkAdventure" text="Park Adventure" textFill="WHITE">
                     <font>
                        <Font name="DejaVu Serif Bold Italic" size="50.0" />
                     </font>
                     <effect>
                        <DropShadow height="13.75" offsetX="3.0" offsetY="2.0" radius="6.6875" spread="0.39" width="15.0">
                           <color>
                              <Color red="0.039" green="0.235" blue="0.552" />
                           </color>
                           <input>
                              <DropShadow height="18.75" offsetX="1.0" offsetY="1.0" radius="9.1875" spread="0.14" width="20.0">
                                 <color>
                                    <Color red="0.629" green="0.697" blue="0.943" />
                                 </color>
                                 <input>
                                    <Lighting specularConstant="0.5">
                                       <bumpInput>
                                          <Shadow blurType="GAUSSIAN">
                                             <color>
                                                <Color red="1.0" green="1.0" blue="1.0" />
                                             </color>
                                          </Shadow>
                                       </bumpInput>
                                       <light>
                                          <Light.Distant />
                                       </light>
                                    </Lighting>
                                 </input>
                              </DropShadow>
                           </input>
                        </DropShadow>
                     </effect>
                  </Label>
               </children>
            </HBox>
         </children>
         <effect>
            <DropShadow />
         </effect>
      </StackPane>
   </top>
</BorderPane>