<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="aba-relatorio" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatorioAtracaoController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="De:" />
            <DatePicker fx:id="dpDe" prefWidth="140.0" />
            <Label text="Até:" />
            <DatePicker fx:id="dpAte" prefWidth="140.0" />
            <Button onAction="#onExportarCsv" styleClass="botao-principal" text="Exportar CSV" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="12.0">
         <children>
            <VBox prefWidth="220" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Atração mais acessada" />
                  <Label fx:id="lblMaisAcessada" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="220" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Acessos no período" />
                  <Label fx:id="lblTotalUsadas" styleClass="card-valor" text="-" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <BarChart fx:id="grafico" legendVisible="true" minHeight="120.0" prefHeight="170" verticalGridLinesVisible="false">
         <xAxis>
            <CategoryAxis side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" />
         </yAxis>
      </BarChart>
      <TableView fx:id="tabela" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colPosicao" maxWidth="50.0" minWidth="40.0" text="#" />
            <TableColumn fx:id="colNome" text="Atração" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colOperador" text="Operador" />
            <TableColumn fx:id="colCapacidade" text="Capacidade" />
            <TableColumn fx:id="colOcupacao" text="Ocupação" />
            <TableColumn fx:id="colOcupacaoPct" text="Ocupação %" />
            <TableColumn fx:id="colReservas" text="Reservas" />
            <TableColumn fx:id="colUsadas" text="Usadas" />
            <TableColumn fx:id="colNoShow" text="No-show" />
            <TableColumn fx:id="colCanceladas" text="Canceladas" />
            <TableColumn fx:id="colSituacao" text="Situação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</VBox>
