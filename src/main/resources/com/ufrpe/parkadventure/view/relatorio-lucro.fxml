<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="aba-relatorio" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.controller.RelatorioLucroController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Ano:" />
            <ComboBox fx:id="cbAno" prefWidth="100.0" />
            <Label text="Custo por operador/dia (R$):" />
            <TextField fx:id="txtCustoOperador" onAction="#onCalcular" prefWidth="90.0" promptText="0,00" />
            <Label text="Custo fixo mensal (R$):" />
            <TextField fx:id="txtCustoFixo" onAction="#onCalcular" prefWidth="90.0" promptText="0,00" />
            <Button onAction="#onCalcular" styleClass="botao-principal" text="Calcular" />
            <Button onAction="#onExportarCsv" styleClass="botao-principal" text="Exportar CSV" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="12.0">
         <children>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Receita no ano" />
                  <Label fx:id="lblReceita" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Custos no ano" />
                  <Label fx:id="lblCusto" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Lucro no ano" />
                  <Label fx:id="lblLucro" styleClass="card-valor" text="-" />
               </children>
            </VBox>
            <VBox prefWidth="170" styleClass="card-relatorio">
               <children>
                  <Label styleClass="card-titulo" text="Margem" />
                  <Label fx:id="lblMargem" styleClass="card-valor" text="-" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <BarChart fx:id="grafico" legendVisible="true" minHeight="120.0" prefHeight="190" verticalGridLinesVisible="false">
         <xAxis>
            <CategoryAxis side="BOTTOM" />
         </xAxis>
         <yAxis>
            <NumberAxis side="LEFT" />
         </yAxis>
      </BarChart>
      <TableView fx:id="tabela" styleClass="tabela-parque" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colMes" text="Mês" />
            <TableColumn fx:id="colIngressos" text="Ingressos" />
            <TableColumn fx:id="colReceita" text="Receita" />
            <TableColumn fx:id="colTurnos" text="Turnos de operador" />
            <TableColumn fx:id="colCusto" text="Custo" />
            <TableColumn fx:id="colLucro" text="Lucro" />
            <TableColumn fx:id="colMargem" text="Margem" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="lblStatus" maxWidth="1.7976931348623157E308" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
   </padding>
   <stylesheets>
      <URL value="@estilo.css" />
      <URL value="@tema-parque.css" />
      <URL value="@relatorios.css" />
   </stylesheets>
</VBox>
