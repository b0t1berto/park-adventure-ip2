<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.collections.*?>
<?import javafx.util.*?>
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" prefHeight="680.0" prefWidth="720.0" styleClass="tela-parque" stylesheets="@tema-parque.css" fx:controller="com.ufrpe.parkadventure.controller.PagamentoController">
    <top>
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cabecalho-pagamento" text="Finalizar compra" BorderPane.alignment="CENTER" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="200.0" styleClass="rolagem-parque" BorderPane.alignment="CENTER">
            <content>
                <StackPane alignment="TOP_CENTER">
                    <children>
                        <VBox alignment="TOP_CENTER" maxWidth="760.0" spacing="16.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="12.0" />
                            </padding>
                            <children>
                                <ImageView fitHeight="64.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-parque">
                                    <image>
                                        <Image url="@imagens/logo.png" />
                                    </image>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                </ImageView>
                                <TitledPane animated="false" collapsible="false" styleClass="secao-parque" text="Resumo da compra">
                                    <content>
                                        <GridPane hgap="12.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="100.0" prefWidth="130.0" />
                                                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="10.0" prefWidth="300.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Ingresso" />
                                                <Label text="Data da visita" GridPane.rowIndex="1" />
                                                <Label text="Quantidade" GridPane.rowIndex="2" />
                                                <Label text="Total" GridPane.rowIndex="3" />
                                                <Label fx:id="lblItem" text="-----" GridPane.columnIndex="1" />
                                                <Label fx:id="lblDataVisita" text="-----" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label fx:id="lblQuantidade" text="-----" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <Label fx:id="lblTotal" styleClass="valor-total" text="-----" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                            </children>
                                            <padding>
                                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                            </padding>
                                        </GridPane>
                                    </content>
                                </TitledPane>
                                <TitledPane animated="false" collapsible="false" styleClass="secao-parque" text="Dados pessoais">
                                    <content>
                                        <GridPane hgap="12.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="120.0" prefWidth="140.0" />
                                                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="10.0" prefWidth="320.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="-1.0" valignment="TOP" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Nome completo" />
                                                <Label text="CPF" GridPane.rowIndex="1" />
                                                <Label text="Data de nascimento" GridPane.rowIndex="2" />
                                                <Label text="E-mail" GridPane.rowIndex="3" />
                                                <Label text="Telefone" GridPane.rowIndex="4" />
                                                <Label text="Altura (cm)" GridPane.rowIndex="5" />
                                                <Label text="Documento com foto" GridPane.rowIndex="6" />
                                                <TextField fx:id="txtNome" GridPane.columnIndex="1" />
                                                <TextField fx:id="txtCpf" promptText="000.000.000-00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <DatePicker fx:id="dpNascimento" promptText="mm/dd/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtEmail" promptText="nome@email.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                <TextField fx:id="txtTelefone" promptText="(00) 90000-0000" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                <Spinner fx:id="spAltura" prefWidth="120.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                                <HBox alignment="CENTER_LEFT" opacity="0.9" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                                                    <children>
                                                        <Button fx:id="btnFotoDocumento" mnemonicParsing="false" onAction="#aoEscolherDocumento" text="Escolher arquivo" wrapText="true" />
                                                        <Label fx:id="lblArquivoDocumento" text="Nenhum arquivo" />
                                                    </children>
                                                </HBox>
                                                <ImageView fx:id="ivDocumento" fitHeight="80.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                            </children>
                                            <padding>
                                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                            </padding>
                                        </GridPane>
                                    </content>
                                </TitledPane>
                                <TitledPane fx:id="paneResponsavel" animated="false" collapsible="false" styleClass="secao-parque" text="Dados do responsável">
                                    <content>
                                        <GridPane hgap="12.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="140.0" prefWidth="160.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="320.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Nome do responsável" />
                                                <Label text="CPF do responsável" GridPane.rowIndex="1" />
                                                <Label text="Contato de emergência" GridPane.rowIndex="2" />
                                                <TextField fx:id="txtNomeResponsavel" GridPane.columnIndex="1" />
                                                <TextField fx:id="txtCpfResponsavel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtContatoEmergencia" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <CheckBox fx:id="chkAutorizacao" mnemonicParsing="false" text="Autorizo a entrada do menor" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                            </children>
                                            <padding>
                                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                            </padding>
                                        </GridPane>
                                    </content>
                                </TitledPane>
                                <TitledPane animated="false" collapsible="false" styleClass="secao-parque" text="Outras informações (opcional)">
                                    <content>
                                        <GridPane hgap="12.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="120.0" prefWidth="180.0" />
                                                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="120.0" prefWidth="280.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="CEP" />
                                                <Label text="Como conheceu o  parque" GridPane.rowIndex="1" />
                                                <TextField fx:id="txtCep" promptText="00000-000" GridPane.columnIndex="1" />
                                                <ComboBox fx:id="cbComoConheceu" prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <CheckBox fx:id="chkPromoEmail" mnemonicParsing="false" text="Quero receber promoções por e-mail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                <CheckBox fx:id="chkPromoWhatsapp" mnemonicParsing="false" text="Quero receber promoções por whatsapp" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                            </children>
                                            <padding>
                                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                            </padding>
                                        </GridPane>
                                    </content>
                                </TitledPane>
                                <TitledPane animated="false" collapsible="false" styleClass="secao-parque" text="Pagamento">
                                    <content>
                                        <VBox spacing="8.0">
                                            <padding>
                                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                            </padding>
                                            <children>
                                                <RadioButton fx:id="rbPix" mnemonicParsing="false" text="Pix">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="grupoPagamento" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="rbCartao" mnemonicParsing="false" text="Cartão de crédito" toggleGroup="$grupoPagamento" />
                                                <RadioButton fx:id="rbBoleto" mnemonicParsing="false" text="Boleto" toggleGroup="$grupoPagamento" />
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="rodape-acoes" BorderPane.alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" styleClass="botao-secundario" text="Voltar" wrapText="true" />
                <Button fx:id="btnPagar" mnemonicParsing="false" onAction="#aoPagar" styleClass="botao-primario" text="Pagar" wrapText="true" />
            </children>
        </HBox>
    </bottom>
</BorderPane>