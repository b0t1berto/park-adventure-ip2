<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ufrpe.parkadventure.javafx_parkadventure.EscalaTrabalhoController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="titulo-tela" text="Escala de trabalho" />
            <Label styleClass="subtitulo" text="Defina quais operadores trabalham em cada dia. Os feriados nacionais vêm da BrasilAPI." />
            <Label fx:id="lblProximoFeriado" maxWidth="Infinity" styleClass="aviso" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela">
         <columns>
            <TableColumn fx:id="colData" text="Data" />
            <TableColumn fx:id="colDia" text="Dia da semana" />
            <TableColumn fx:id="colOperador" text="Operador" />
            <TableColumn fx:id="colAtracao" text="Atração" />
            <TableColumn fx:id="colObservacao" text="Observação" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <VBox spacing="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Data:" />
                  <DatePicker fx:id="dpData" />
                  <Label text="Operador:" />
                  <ComboBox fx:id="cbOperador" prefWidth="200.0" />
                  <Button onAction="#onEscalar" styleClass="botao-principal" text="Escalar" />
                  <Button onAction="#onRemover" text="Remover linha selecionada" />
               </children>
            </HBox>
            <Label fx:id="lblStatus" maxWidth="Infinity" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets top="12.0" />
         </BorderPane.margin>
      </VBox>
   </bottom>
</BorderPane>