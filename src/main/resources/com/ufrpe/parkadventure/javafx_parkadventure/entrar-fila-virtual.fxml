<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="880.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ufrpe.parkadventure.javafx_parkadventure.EntrarFilaVirtualController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <top>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" />
         </padding>
         <children>
            <Label text="Entrar na fila virtual">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label fx:id="lblVisitante" />
            <Label maxWidth="1.7976931348623157E308" text="Escolha a atração e o horário em que você quer ser chamado. Você pode entrar na fila de mais de uma atração." wrapText="true" />
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabela" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colAtracao" prefWidth="75.0" text="Atração" />
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
            <TableColumn fx:id="colRequisitos" prefWidth="75.0" text="Requisitos" />
            <TableColumn fx:id="colSituacao" prefWidth="75.0" text="Situação para você" />
            <TableColumn fx:id="colFila" prefWidth="75.0" text="Na fila" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Label text="Horário:" />
                  <ComboBox fx:id="cbHorario" prefWidth="140.0" promptText="Escolha" />
                  <Label fx:id="lblVagas" />
               </children>
            </HBox>
            <Label fx:id="lblResultado" maxWidth="1.7976931348623157E308" wrapText="true" />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
               <children>
                  <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#onVoltar" prefWidth="120.0" text="Voltar" />
                  <Button fx:id="btnEntrar" mnemonicParsing="false" onAction="#onEntrarNaFila" prefWidth="160.0" text="Entrar na fila" />
                  <Button fx:id="btnContinuar" disable="true" mnemonicParsing="false" onAction="#onContinuar" prefWidth="220.0" text="Continuar para o pagamento" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
